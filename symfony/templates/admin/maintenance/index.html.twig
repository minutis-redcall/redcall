{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block body %}

    <div class="rc-section rc-section-center text-center">

        <form method="post" action="{{ path('admin_maintenance_data_sync') }}">
            <input type="hidden" name="csrf" value="{{ csrf_token('maintenance') }}"/>
            <button type="submit" class="text-lg-center large-button btn btn-secondary">{{ 'maintenance.data_sync'|trans }}</button>
        </form>

        <div class="mb-2"></div>

        <form method="post" action="{{ path('admin_maintenance_annuaire_national') }}">
            <input type="hidden" name="csrf" value="{{ csrf_token('maintenance') }}"/>
            <button type="submit" class="text-lg-center large-button btn btn-secondary">{{ 'maintenance.annuaire'|trans }}</button>
        </form>

        <div class="mb-2"></div>

        <a href="{{ path('admin_maintenance_message') }}"
           class="text-lg-center large-button btn btn-secondary">{{ 'maintenance.message.title'|trans }}</a>

        <div class="mt-4"></div>

        <div class="rc-back-link">
            <a href="{{ path('admin_home') }}"
               class="btn btn-secondary">{{ 'base.button.back'|trans }}</a>
        </div>

    </div>

{% endblock %}
