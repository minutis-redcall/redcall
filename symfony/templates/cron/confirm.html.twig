{% extends 'base.html.twig' %}

{% block body %}

    <div class="rc-section rc-section-center text-center">
        <h3>{{ 'cron.confirm.title'|trans({'%command%': key}) }}</h3>

        <form method="post" class="mt-3">
            <input type="hidden" name="csrf" value="{{ csrf_token('cron') }}"/>
            <button type="submit" class="btn btn-danger">{{ 'cron.confirm.run'|trans }}</button>
        </form>
    </div>

{% endblock %}
